# "Error" patterns that are known-harmless noise and should never be
# treated as evidence of failure.
DEFAULT_IGNORE_PATTERNS: List[str] = [
    r"Fontconfig\s+error:",
]


# ----------------------------------------------------------------------
# Error catalog
#
# Each rule is checked, in order, against every candidate line. The first
# rule that matches a given line "wins" for that line (we don't keep
# checking lower-priority rules against the same line) -- so put more
# specific patterns before more generic ones. A rule with stop_scan=True
# means: once this fires, stop reading the rest of the log entirely,
# because the failure is a root cause likely to cascade into other,
# less informative errors (e.g. a cancelled job will often also look
# like a FileNotFoundError further down).
#
# label may be a plain string, or a callable(match) -> str if you want to
# fold matched text (e.g. the SLURM cancellation reason) into the label.
#
# This list is deliberately broader than what we've actually seen fail --
# several entries are speculative, based on common, well-documented
# fMRIPrep/Nipype/SLURM/Apptainer failure modes, since a single project's
# history is unlikely to be exhaustive. Treat any label you never see
# fire as free to prune, and add more as new failure modes turn up.
# ----------------------------------------------------------------------

LabelFn = Callable[[re.Match], str]


@dataclass
class ErrorRule:
    pattern: re.Pattern
    label: str
    stop_scan: bool = False
    label_fn: Optional[LabelFn] = None

    def match_label(self, line: str) -> Optional[str]:
        m = self.pattern.search(line)
        if not m:
            return None
        return self.label_fn(m) if self.label_fn else self.label


def _rule(pattern: str, label: str, stop_scan: bool = False, label_fn: Optional[LabelFn] = None) -> ErrorRule:
    return ErrorRule(re.compile(pattern, re.I), label, stop_scan, label_fn)


ERROR_CATALOG: List[ErrorRule] = [
    # ---- SLURM job-control failures -----------------------------------
    # More specific "why was it cancelled" checks first, generic fallback last.
    _rule(r"CANCELLED AT.*DUE TO TIME LIMIT", "Job cancelled (time limit)", stop_scan=True),
    _rule(r"CANCELLED AT.*DUE TO NODE FAILURE", "Job cancelled (node failure)", stop_scan=True),
    _rule(r"CANCELLED AT.*(DUE TO )?.*OOM", "Job cancelled (out of memory)", stop_scan=True),
    _rule(r"\bCANCELLED AT\b", "Job cancelled", stop_scan=True),
    _rule(r"\bDUE TO NODE FAILURE\b", "Job cancelled (node failure)", stop_scan=True),
    _rule(r"\bdetected \d+ oom.?kill event", "Job killed (out of memory, cgroup)", stop_scan=True),
    _rule(r"\boom.?kill", "Job killed (out of memory)", stop_scan=True),

    # ---- Container / environment failures -----------------------------
    _rule(r"\bcontainer creation failed\b", "Container error", stop_scan=True),
    _rule(r"FATAL:.*(image file|no such file)", "Container image not found", stop_scan=True),
    _rule(r"FATAL:.*permission denied", "Container permission error", stop_scan=True),

    # ---- Filesystem / storage failures ---------------------------------
    _rule(r"No space left on device", "Disk full", stop_scan=True),
    _rule(r"Disk quota exceeded", "Disk quota exceeded", stop_scan=True),
    _rule(r"Stale file handle", "Stale NFS handle", stop_scan=True),
    _rule(r"Read-only file system", "Read-only filesystem", stop_scan=True),

    # ---- Licensing / setup problems (speculative but common) -----------
    _rule(r"freesurfer license.*(not found|invalid|missing)", "FreeSurfer license missing/invalid", stop_scan=True),
    _rule(r"license\.txt.*not found", "FreeSurfer license missing/invalid", stop_scan=True),

    # ---- FreeSurfer / midthickness failures -----------------------------
    _rule(r"\*\*\* buffer overflow detected \*\*\*", "FreeSurfer buffer overflow", stop_scan=True),
    _rule(r"RuntimeError: subprocess exited with code\s*134", "FreeSurfer crash (code134)", stop_scan=True),
    _rule(r"Node _midthickness0 failed", "FreeSurfer node failure", stop_scan=True),

    # ---- BIDS / input data problems -------------------------------------
    _rule(r"BIDS validation failed", "BIDS validation failed", stop_scan=False),
    _rule(r"Invalid BIDSLayout", "Invalid BIDS layout", stop_scan=False),
    _rule(r"Multiple T1w images (found|were found)", "Multiple/ambiguous T1w images", stop_scan=False),
    _rule(r"\bFileNotFoundError\b.*t1w", "No T1w images found", stop_scan=False),
    _rule(r"\bFileNotFoundError\b", "File not found", stop_scan=False),

    # ---- Generic Nipype / Python / OS failures ---------------------------
    _rule(r"\bSegmentation fault\b", "Segmentation fault", stop_scan=False),
    _rule(r"\bMemoryError\b", "Python MemoryError", stop_scan=False),
    _rule(r"\bBroken pipe\b", "Broken pipe", stop_scan=False),
    _rule(r"\bKilled\b", "Process killed", stop_scan=False),
    _rule(r"Traceback \(most recent call last\)", "Unhandled Python exception", stop_scan=False),
    _rule(r"\bERROR\b", "General error (ERROR)", stop_scan=False),
]


def build_ignore_patterns(cfg: Dict[str, Any]) -> List[re.Pattern]:
    raw = cfg.get("ignore_patterns", DEFAULT_IGNORE_PATTERNS)
    return [re.compile(p, re.I) for p in raw]


# ----------------------------------------------------------------------
# Content-based fallback for subject-id extraction.
#
# sid_pattern/date_pattern are matched against the *filename* first, since
# that's cheap and usually sufficient. When a file's name doesn't match --
# e.g. a naming convention nobody's told the config about yet -- rather
# than silently skipping it, we check whether it actually looks like an
# fMRIPrep log at all (via SIGNATURE_PATTERNS), and if so, try a short list
# of common id conventions against its first ~60 lines. This is a guess,
# not a substitute for a correct sid_pattern, so any file id found this way
# is logged (in --debug) as "from content", and the recommended fix if it
# fires a lot is still to set sid_pattern in a config.
# ----------------------------------------------------------------------
SIGNATURE_PATTERNS: List[re.Pattern] = [
    re.compile(r"Running fMRIPrep version", re.I),
    re.compile(r"nipype\.workflow", re.I),
    re.compile(r"\bfmriprep-\d", re.I),
]

FALLBACK_SID_PATTERNS: List[re.Pattern] = [
    re.compile(r"sub-(?P<sid>[A-Za-z0-9]+)", re.I),
    re.compile(r"(?i:sid)[-_]?(?P<sid>\d+)"),
    re.compile(r"participant(?:[-_ ]?label)?[:=]?\s*(?P<sid>[A-Za-z0-9]+)", re.I),
]

HEAD_SCAN_LINES = 60


def _head_text(path: Path, n_lines: int = HEAD_SCAN_LINES) -> str:
    lines: List[str] = []
    try:
        with path.open(errors="replace") as f:
            for i, line in enumerate(f):
                if i >= n_lines:
                    break
                lines.append(line)
    except OSError:
        pass
    return "".join(lines)


def looks_like_fmriprep_log(head_text: str) -> bool:
    return any(p.search(head_text) for p in SIGNATURE_PATTERNS)


def sid_from_content(head_text: str) -> Optional[str]:
    for pat in FALLBACK_SID_PATTERNS:
        m = pat.search(head_text)
        if m:
            return m.group("sid")
    return None


# ----------------------------------------------------------------------
#  Argument parsing
# ----------------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Summarize fMRIPrep logs and check run statuses.",
        epilog=(
            "Config is resolved in this order: CLI flags > --config file > "
            "a fmriprep_log_check.yaml/.json found in the current directory > "
            "built-in defaults. With no log_root configured at all, you'll be "
            "prompted interactively (or told what to pass, if not interactive)."
        ),
    )
    p.add_argument("-c", "--config", type=str, help="Path to a YAML or JSON config file.")
    p.add_argument("--log-root", type=str, help="Directory containing the logs (overrides config).")
    p.add_argument("--log-glob", type=str, help="Glob for log files, e.g. '*.txt' (default: *.txt).")
    p.add_argument("--recursive", action="store_true", default=None,
                    help="Search log-root recursively for matching files.")
    p.add_argument("--out-dir", type=str, help="Where to write the CSV/HTML report (default: next to log-root).")
    p.add_argument("--start-date", type=str, help="Only consider logs on or after this date (YYYYMMDD).")
    p.add_argument("--end-date", type=str, help="Upper bound for log dates (inclusive, YYYYMMDD).")
    p.add_argument("--title", type=str, help="Title used in the HTML report.")
    p.add_argument("--only", choices=["all", "successful", "failed", "in-progress", "unfinished"],
                    default="all", help="Filter the terminal/HTML report to one status (CSV always has everything).")
    p.add_argument("--include", type=str, help="Only process log files whose name contains this string.")
    p.add_argument("--exclude", type=str, help="Skip log files whose name contains this string.")
    p.add_argument("--no-input", action="store_true",
                    help="Never prompt interactively; fail with an error if log-root can't be resolved.")
    p.add_argument("-d", "--debug", action="store_true", help="Print verbose debugging information.")
    return p


def load_cfg_from_file(cfg_path: Path) -> Dict[str, Any]:
    if not cfg_path.is_file():
        raise FileNotFoundError(f"Config file not found: {cfg_path}")
    if cfg_path.suffix.lower() in (".yaml", ".yml"):
        with cfg_path.open() as f:
            return yaml.safe_load(f) or {}
    elif cfg_path.suffix.lower() == ".json":
        with cfg_path.open() as f:
            return json.load(f)
    else:
        raise ValueError("Config file must be .yaml/.yml or .json")


def discover_local_config() -> Optional[Path]:
    """Look for a config file with a known name in the current directory."""
    for name in AUTO_CONFIG_NAMES:
        candidate = Path.cwd() / name
        if candidate.is_file():
            return candidate
    return None


def merge_cfg(default: Dict[str, Any], update: Dict[str, Any]) -> Dict[str, Any]:
    """Shallow merge -- keys in *update* replace those in *default*."""
    cfg = default.copy()
    cfg.update(update or {})
    return cfg


def resolve_log_root_interactively(no_input: bool, console: Console) -> Path:
    """
    Called only when no log_root came from CLI flags, an explicit config
    file, an auto-discovered config file, or the environment. Never runs
    unless stdin is a TTY and --no-input wasn't passed.
    """
    cwd = Path.cwd()
    if no_input or not sys.stdin.isatty():
        console.print(
            "[red]No log directory configured.[/] Pass --log-root PATH, "
            "or --config FILE, or add a fmriprep_log_check.yaml to the "
            "current directory."
        )
        sys.exit(2)

    console.print(f"[yellow]No log directory configured.[/] Current directory is: {cwd}")
    console.print("  1) Use the current directory")
    console.print("  2) Enter a path")
    console.print("  3) Abort")
    choice = input("Choose [1/2/3]: ").strip()

    if choice == "1":
        return cwd
    elif choice == "2":
        raw = input("Path to log directory: ").strip()
        if not raw:
            console.print("[red]No path entered, aborting.[/]")
            sys.exit(2)
        return Path(raw).expanduser()
    else:
        console.print("Aborted.")
        sys.exit(1)


def initialize_cfg(argv: Optional[List[str]] = None) -> Tuple[Dict[str, Any], argparse.Namespace, Console]:
    args = build_parser().parse_args(argv)
    console = Console()

    cfg: Dict[str, Any] = DEFAULT_CFG.copy()
    used_config_path: Optional[Path] = None

    if args.config:
        used_config_path = Path(args.config)
        try:
            cfg = merge_cfg(cfg, load_cfg_from_file(used_config_path))
        except (FileNotFoundError, ValueError, yaml.YAMLError, json.JSONDecodeError) as exc:
            console.print(f"[red]Could not load config file {used_config_path}: {exc}[/]")
            sys.exit(2)
    else:
        auto = discover_local_config()
        if auto:
            used_config_path = auto
            try:
                cfg = merge_cfg(cfg, load_cfg_from_file(auto))
            except (FileNotFoundError, ValueError, yaml.YAMLError, json.JSONDecodeError) as exc:
                console.print(f"[red]Could not load auto-discovered config file {auto}: {exc}[/]")
                sys.exit(2)

    # CLI flags win over any config file.
    if args.log_root:
        cfg["log_root"] = args.log_root
    if args.log_glob:
        cfg["log_glob"] = args.log_glob
    if args.recursive is not None:
        cfg["log_recursive"] = args.recursive
    if args.out_dir:
        cfg["out_dir"] = args.out_dir
    if args.start_date:
        cfg["date_start"] = args.start_date
    if args.end_date:
        cfg["date_end"] = args.end_date
    if args.title:
        cfg["html_title"] = args.title

    if args.debug:
        if used_config_path:
            console.print(f"[cyan]Using config file:[/] {used_config_path}")
        else:
            console.print("[cyan]No config file found; using built-in defaults + CLI flags.[/]")

    # Resolve log_root: explicit config/CLI value, else interactive/careful fallback.
    if not cfg.get("log_root"):
        cfg["log_root"] = str(resolve_log_root_interactively(args.no_input, console))

    log_root = Path(cfg["log_root"]).expanduser()
    if not log_root.is_dir():
        console.print(f"[red]log_root does not exist or is not a directory:[/] {log_root}")
        sys.exit(2)
    cfg["log_root"] = str(log_root)

    if cfg.get("out_dir"):
        out_dir = Path(cfg["out_dir"]).expanduser()
    else:
        out_dir = log_root.parent
    out_dir.mkdir(parents=True, exist_ok=True)
    cfg["out_dir"] = str(out_dir)

    cfg["sid_re"] = re.compile(cfg["sid_pattern"])
    cfg["date_re"] = re.compile(cfg["date_pattern"])
    cfg["deriv_pattern_res"] = [re.compile(p, re.I) for p in cfg.get("deriv_patterns", [])]
    cfg["ignore_res"] = build_ignore_patterns(cfg)
    cfg["bids_line_re"] = re.compile(r"\* BIDS dataset path:\s*(?P<path>\S+)", re.I)

    cfg["date_start_dt"] = (
        datetime.strptime(cfg["date_start"], "%Y%m%d").date() if cfg.get("date_start") else None
    )
    cfg["date_end_dt"] = (
        datetime.strptime(cfg["date_end"], "%Y%m%d").date() if cfg.get("date_end") else None
    )

    return cfg, args, console


